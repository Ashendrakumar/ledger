{
  "expo": {
    "name": "Ledger",
    "slug": "ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-76.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon-76.png",
        "dark": "./assets/icon-dark (1).png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1A17",
        "foregroundImage": "./assets/adaptive-foreground-432 (1).png",
        "monochromeImage": "./assets/adaptive-monochrome-432 (1).png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ifourashendra.ledger",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-48.png",
      "themeColor": "#0E1A17",
      "backgroundColor": "#0E1A17",
      "splash": {
        "image": "./assets/splash-icon (1).png",
        "resizeMode": "contain",
        "backgroundColor": "#0E1A17"
      }
    },
    "scheme": "ledger",
    "plugins": [
      "react-native-nitro-google-signin",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon (1).png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1A17"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-xxxhdpi-96 (1).png",
          "color": "#5FD3B5",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ledger uses Face ID to unlock your data."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "react-native-nitro-google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8caba142-7b25-4fd1-b444-d642664abd74"
      }
    },
    "owner": "ifourashendra"
  }
}
