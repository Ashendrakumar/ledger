NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
MONGODB_URI=mongodb://127.0.0.1:27017/ledger
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-a-different-random-secret
WEB_ORIGIN=http://localhost:8081
# Required when NODE_ENV=production. Provider implementation is not configured yet.
MAIL_FROM=
MAIL_API_KEY=
